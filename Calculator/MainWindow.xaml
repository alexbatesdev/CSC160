<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="400">
    <DockPanel>
        <TextBox x:Name="InOutTextBox"
            DockPanel.Dock="Top"
            Height="150"
            FontSize="64" 
            MaxLines="2" 
            TextWrapping="Wrap"
            TextBlock.LineStackingStrategy="BlockLineHeight" 
            TextBlock.LineHeight="70" KeyDown="InOutTextBox_KeyDown"
        />
        <Grid x:Name="ButtonGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Start of digits -->
            <Button
                Grid.Column="0"
                Grid.Row="1"
                Content="1"
                Tag="1"
                FontSize="32" 
                Click="Button_Click"
            />
            <Button
                Grid.Column="1"
                Grid.Row="1"
                Content="2"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="2"
                Grid.Row="1"
                Content="3"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="0"
                Grid.Row="2"
                Content="4"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="1"
                Grid.Row="2"
                Content="5"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="2"
                Grid.Row="2"
                Content="6"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="0"
                Grid.Row="3"
                Content="7"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="1"
                Grid.Row="3"
                Content="8"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="2"
                Grid.Row="3"
                Content="9"
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="1"
                Grid.Row="4"
                Content="0"
                FontSize="32"
                Click="Button_Click"
            />
            <!-- End of digits -->
            <Button
                Grid.Column="0"
                Grid.Row="4"
                Content="."
                FontSize="32"
                Click="Button_Click"
            />
            <Button
                Grid.Column="1"
                Grid.Row="0"
                Content="&lt;[x]"
                FontSize="32" Click="Button_Click_del"
            />
            <!-- Operators -->
            <Button
                Grid.Column="3"
                Grid.Row="0"
                Content="+"
                FontSize="32"
                Click="Button_Click"
             />
            <Button
                Grid.Column="3"
                Grid.Row="1"
                Content="-"
                FontSize="32"
                Click="Button_Click"
             />
            <Button
                Grid.Column="3"
                Grid.Row="2"
                Content="/"
                FontSize="32"
                Click="Button_Click"
             />
            <Button
                Grid.Column="3"
                Grid.Row="3"
                Content="*"
                FontSize="32"
                Click="Button_Click"
             />
            <Button
                Grid.Column="2"
                Grid.Row="0"
                Content="(+/-)"
                FontSize="32"
                Click="Button_Click_SwapSign"
             />
            <Button
                Grid.Column="2"
                Grid.Row="4"
                Content="!"
                FontSize="32"
                Click="Button_Click"
             />
            <!-- End of operators -->
            <Button
                Grid.Column="0"
                Grid.Row="0"
                Content="CLR"
                FontSize="32"
                Click="Button_Click_Clear"
             />
            <Button
                Grid.Column="3"
                Grid.Row="4"
                Content="="
                FontSize="32"
                Click="Button_Click_Equals"
            />

            <Button
                Grid.Column="0"
                Grid.Row="5"
                Grid.ColumnSpan="2"
                Content="History"
                FontSize="32"
                Click="Button_Click_History"
            />

            <Button
                Grid.Column="2"
                Grid.Row="5"
                Grid.ColumnSpan="2"
                FontSize="32"
                Click="Button_Click_Work"
            >
                <CheckBox 
                    x:Name="ShowWorkCheckBox" 
                    IsChecked="False" 
                    VerticalAlignment="Center" 
                    VerticalContentAlignment="Center"
                    Click="Button_Click_Work"
                >
                    <TextBlock 
                        Text="Show Work" 
                        VerticalAlignment="Center"
                    />
                </CheckBox>
            </Button>
        </Grid>
    </DockPanel>
</Window>
