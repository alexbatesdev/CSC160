<Window x:Class="WpfApp1.UControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        xmlns:uc="clr-namespace:WpfApp1.UserControls"
        Title="UControl" Height="100" Width="400" SizeToContent="WidthAndHeight">
    <!-- Don't forget xmlns:uc for reference to UserControls-->
    <StackPanel>
        <uc:TextBoxLimiter Title="Name" MaxLength="30" TitleWidth="70" />
        <uc:TextBoxLimiter Title="Address" MaxLength="30" TitleWidth="70" />
        <uc:TextBoxLimiter Title="SSN" MaxLength="30" TitleWidth="70" />
    </StackPanel>
</Window>
