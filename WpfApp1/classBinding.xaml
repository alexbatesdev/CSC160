<Window x:Class="WpfApp1.classBinding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="classBinding" Height="650" Width="500">
    <StackPanel>
        <Label
            Name="titleLabel"
            Content="Title: "
            FontSize="32"
        />
        <Label 
            Name="titleLabelBound"
            Content="{Binding gameTitle}"
            FontSize="32"
        />
        <Button
            Name="setTitleButton"
            Content="Set Game Title" 
            Click="setTitleButton_Click"
        />

    </StackPanel>
</Window>
