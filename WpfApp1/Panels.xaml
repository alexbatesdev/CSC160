<Window x:Class="WpfApp1.Panels"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Panels" Height="600" Width="800">
    <DockPanel>
        <Label 
            Content="Panels" 
            FontSize="32" 
            Foreground="BlueViolet" 
            HorizontalAlignment="Center" 
            DockPanel.Dock="Top" 
        />
        <Border 
            BorderBrush="Black"
            BorderThickness="5"
        >
            <Grid ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label 
                    Content="GRID" 
                    FontSize="32" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Grid.Column="0" Grid.Row="0"
                />
                <WrapPanel
                    Orientation="Horizontal"
                    Grid.Column="1" Grid.Row="0"
                >
                    <Button Width="60" Height="60" Margin="10">Button 1</Button>
                    <Button Width="60" Height="60" Margin="10">Button 2</Button>
                    <Button Width="60" Height="60" Margin="10">Button 3</Button>
                    <Button Width="60" Height="60" Margin="10">Button 4</Button>
                    <Button Width="60" Height="60" Margin="10">Button 5</Button>
                    <Button Width="60" Height="60" Margin="10">Button 6</Button>
                    <Button Width="60" Height="60" Margin="10">Button 7</Button>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Button Margin="5">Button 1</Button>
                    <Button Margin="5">Button 2</Button>
                    <Button Margin="5">Button 3</Button>
                    <Button Margin="5">Button 4</Button>
                </StackPanel>
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Button Margin="5" DockPanel.Dock="Top">Button 1</Button>
                    <Button Margin="5" DockPanel.Dock="Left">Button 1</Button>
                    <Button Margin="5" DockPanel.Dock="Right">Button 1</Button>
                    <Button Margin="5" DockPanel.Dock="Bottom">Button 1</Button>
                </DockPanel>
                <Button Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                    <TextBlock TextWrapping="Wrap">
                        Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide
                    </TextBlock>
                </Button>
                <TextBlock Grid.Column="1" Grid.Row="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide Double Wide
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</Window>
