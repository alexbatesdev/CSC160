<Window x:Class="WpfApp1.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Controls" Height="450" Width="800">
    <DockPanel>
        <Label
            Content="Controls"
            FontSize="32"
            DockPanel.Dock="Top"
            HorizontalAlignment="Center"
        />
        <Border 
            BorderBrush="black"
            BorderThickness="3"
        >
            <Grid ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock 
                        Text="Hello World"
                        FontSize="16"
                    />
                    <TextBlock 
                        FontSize="16"
                    >
                        This is a <Bold>bold</Bold> text
                        <Span Foreground="Red"> and this is red blah blah blah</Span>
                    </TextBlock>
                </StackPanel>
                <Label
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Margin="20"
                >
                    <StackPanel
                        Orientation="Vertical"
                    >
                        <Image 
                            Name="img" 
                            Source="Resources\correct-icon.png" 
                            Width="50" 
                        />
                        <Label Content="This is a label"
                            FontSize="16"
                        />
                        <TextBlock TextWrapping="Wrap">
                            Don't forget you need to set your images build action to resource
                        </TextBlock>
                    </StackPanel>
                </Label>

                <TextBox 
                    Name="textInfo"
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AcceptsReturn="True"
                    SpellCheck.IsEnabled="True"
                />

                <Button 
                    Name="PanicButton"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Content="Panic!"
                    Click="PanicButton_Click"
                />
            </Grid>
        </Border>
    </DockPanel>
</Window>
