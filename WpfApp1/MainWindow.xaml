<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        x:Name="window"
        Background="Azure">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="MyButton" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Grid.Row="2" 
            Grid.Column="1" 
            Width="120" 
            FontSize="15"
            FontFamily="Arial" 
            Click="MyButton_Click"
            Padding="10"
        >
            <!--<Button.Content>
                Click Me!
                --><!--Comment--><!--
            </Button.Content>-->
            <StackPanel x:Name="___No_Name_" Orientation="Vertical">
                <Label Content="Click Me!" />
                <TextBlock x:Name="BananaBox" Text="Bananas!" />
                <Slider x:Name="MySlider" Width="100" HorizontalAlignment="Center" ValueChanged="Slider_ValueChanged" />
            </StackPanel>
        </Button>
        <Label Content="Hello World" />
        <ComboBox Name="ComboRIP" Height="30" Width="200" Grid.Row="1" Grid.Column="1" SelectionChanged="ComboRIP_SelectionChanged">
            <ComboBoxItem Content="Combo" />
            <ComboBoxItem Content="Jesse" />
            <ComboBoxItem Content="Badger" />
        </ComboBox>
    </Grid>
</Window>
