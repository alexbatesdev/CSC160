<UserControl x:Class="Final.UserControls.EmailValidator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Final.UserControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="250">
    <UserControl.Resources>
        <SolidColorBrush x:Key="isValid" Color="Red" />
    </UserControl.Resources>
    <WrapPanel
        Background="White"
        VerticalAlignment="Center"
        Orientation="Horizontal"
    >
        <Label
            Content="Email: "
            Margin="10"
            VerticalAlignment="Center"
        />
        <TextBox
            x:Name="Email_in"
            Width="125"
            Height="25" TextChanged="Email_in_TextChanged"
        />
        <Label
            x:Name="isValid"
            Foreground="{DynamicResource isValid}"
            Content="Invalid"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        />

    </WrapPanel>
</UserControl>
