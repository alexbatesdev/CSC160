<UserControl x:Class="DnDCharacterGen.UserControls.footer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DnDCharacterGen.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="50" d:DesignWidth="500"
>

    <StackPanel Background="AliceBlue">
        <TextBlock Text="{Binding Prompt}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
