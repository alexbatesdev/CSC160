<Window x:Class="DnDCharacterGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DnDCharacterGen"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:SampleName="clr-namespace:DnDCharacterGen.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="525" Width="500">
    <Window.Resources>
        <SolidColorBrush x:Key="Background" Color="White" />
        <FontStyle x:Key="fontStyle">italic</FontStyle>
    </Window.Resources>
    <StackPanel Background="{StaticResource Background}">
        <Grid Height="458">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />

            </Grid.RowDefinitions>
            <!-- Title -->
            <Label
                Content="Character Generator: "
                FontSize="32"
                Grid.Column="0"
                Grid.Row="0"
                Grid.ColumnSpan="5"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <!-- Name -->
            <Label
                Content="Name: "
                FontSize="24"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <StackPanel
                Grid.Row="1"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                >
                <TextBox
                    Name="NameInput"
                    Height="30"
                    Width="150"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Text="{Binding Name}" ToolTip="Name Here"
                />
                <TextBlock Text="{Binding Path=Text, ElementName=NameInput}"/>
            </StackPanel>
            
            <!-- Age -->
            <Label
                Content="Age: "
                FontSize="24"
                Grid.Column="4"
                Grid.Row="1"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <Label
                Name="AgeOutput"
                Content="{Binding Age}"
                FontSize="24"
                Grid.Column="5"
                Grid.Row="1"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <!-- Sex -->
            <Label
                Content="Sex: "
                FontSize="24"
                Grid.Column="0"
                Grid.Row="2"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <Label
                Name="SexOutput"
                Content="{Binding Sex}"
                FontSize="24"
                Grid.Column="1"
                Grid.Row="2"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <!-- Gender -->
            <Label
                Content="Gender: "
                FontSize="24"
                Grid.Column="2"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <StackPanel
                Grid.Column="4"
                Grid.Row="2"
                Grid.ColumnSpan="2" 
                VerticalAlignment="Center"
                
            >
                <WrapPanel
                    Orientation="Horizontal"
                >
                    <Label Content="Female" Margin="0,0,35,0" />
                    <Label Content="Male" Margin="35,0,0,0" />
                </WrapPanel>
                <Slider 
                    Name="GenderOut"
                    Maximum="1" 
                    LargeChange="0.1" 
                    Value="{Binding Gender}" 
                    Width="150" 
                    Height="18" IsEnabled="False"
                    
                />
            </StackPanel>
            <!-- Race -->
            <Label
                Content="Race: "
                FontSize="24"
                Grid.Column="0"
                Grid.Row="3"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <Label
                Name="RaceOut"
                Content="{Binding Race}"
                FontSize="24"
                Grid.Column="1"
                Grid.Row="3"
                Grid.ColumnSpan="2"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <!-- Class -->
            <Label
                Content="Class: "
                FontSize="24"
                Grid.Column="3"
                Grid.Row="3"
                Grid.ColumnSpan="1"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <Label
                Name="ClassOut"
                Content="{Binding DnDClass}"
                FontSize="24"
                Grid.Column="4"
                Grid.Row="3"
                Grid.ColumnSpan="2"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
            />
            <!-- Buttons -->
            <Button
                Name="GenerateButton"
                Content="Generate"
                FontSize="24"
                Grid.Column="0"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                Height="50"
                Width="150"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center" 
                Click="GenerateButton_Click"
            />
            <Button
                Name="KeepNameButton"
                FontSize="24"
                Grid.Column="3"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                Height="50"
                Width="150"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center" 
                Click="KeepNameButton_Click"
            >
                <CheckBox 
                    x:Name="KeepNameCheckBox" 
                    IsChecked="True" 
                    VerticalAlignment="Center" 
                    VerticalContentAlignment="Center"
                >
                    <TextBlock 
                        Text="Keep Name" 
                        VerticalAlignment="Center"
                    />
                </CheckBox>
            </Button>
        </Grid>
        <SampleName:footer Prompt="©Copyright Alex Bates Do Not Steal Grrrr" FontStyle="{StaticResource fontStyle}" />
    </StackPanel>
</Window>
