<Window x:Class="Login.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Login"
        mc:Ignorable="d"
        Title="SignUp" 
        Height="450" 
        Width="800"
        FontFamily="Consolas"
    >
    <Grid
        Background="Black"
    >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            
        </Grid.ColumnDefinitions>
        <Rectangle
            Grid.Row="1"
            Grid.Column="1"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Fill="Black"
            Stroke="#11dd21"
            StrokeThickness="5"
            />
        <StackPanel
            Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
        >
            <Label 
                Content="Username:"  
                Foreground="#11dd21" 
                FontSize="20" 
                Margin="10 0"
            />
            <TextBox 
                Name="UsernameTextBox"
                Width="150"
                Margin="10"
            />
            <Label 
                Content="Name:" 
                Foreground="#11dd21" 
                FontSize="20" 
                Margin="10 0"
            />
            <TextBox 
                Name="NameTextBox"
                Width="150"
                Margin="10"
            />
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="2"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
        >
            <Label 
                Content="Password:" 
                Grid.Row="1" 
                Grid.Column="1" 
                Foreground="#11dd21" 
                FontSize="20" 
                Margin="10 0"
            />
            <TextBox 
                Name="PasswordTextBox"
                Width="150"
                Margin="10"
            />
            <Label 
                Content="Email:" 
                Foreground="#11dd21" 
                FontSize="20" 
                Margin="10 0"
            />
            <TextBox 
                Name="EmailTextBox"
                Width="150"
                Margin="10"
            />
        </StackPanel>
        <Button
            Grid.Column="1"
            Grid.Row="3"
            Width="150"
            Height="25"
            Content="Back"
            Foreground="Red"
            Background="Black" Click="Button_Click"
        />
        <Button
            Grid.Column="2"
            Grid.Row="3"
            Width="150"
            Height="25"
            Content="Sign Up"
            Foreground="#11dd21"
            Background="Black" Click="Button_Click_1"
        />
    </Grid>
</Window>
